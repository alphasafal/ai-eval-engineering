# ---------------------------------------------------------------------------
# AI Eval Engineering — configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Which provider runs the agent: mock | openai | anthropic
# "mock" is deterministic, offline and free. It is the default.
AI_PROVIDER=mock

# Model name sent to the real provider (ignored in mock mode).
# Also used to look up pricing in config/model-pricing.ts.
AI_MODEL=

# Semantic (LLM-as-a-judge) grader: mock | model | off
#   mock  = deterministic simulated judge (no API calls)
#   model = uses JUDGE_PROVIDER / JUDGE_MODEL
EVAL_JUDGE=mock
JUDGE_PROVIDER=
JUDGE_MODEL=

# OpenAI or any OpenAI-compatible Chat Completions endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Messages API
ANTHROPIC_API_KEY=

# Number of cases evaluated concurrently
EVAL_CONCURRENCY=4
